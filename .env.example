# Copia este archivo a ".env" y rellena los valores.
# ".env" NUNCA se sube a git (ya está en .gitignore).
# Genera secretos con:  openssl rand -base64 24

# --- PostgreSQL (omniagenda_db) ---
POSTGRES_USER=omniagenda_user
POSTGRES_PASSWORD=
POSTGRES_DB=omniagenda_db
# El host es "omniagenda_db" (nombre del servicio en docker-compose), NO
# localhost — el backend le habla por la red interna de Docker. El puerto
# interno es 5432; el 5439 del host solo sirve para conectarte con un
# cliente de escritorio desde FUERA de Docker.
DATABASE_URL=postgresql://omniagenda_user:PON_LA_MISMA_CONTRASENA_AQUI@omniagenda_db:5432/omniagenda_db

# --- Redis (omniagenda_redis) ---
REDIS_PASSWORD=

# --- Reservado para fases siguientes (todavia no se usan) ---
# Fase 3 (auth, portada de OmniUser):
#   JWT_SECRET=
#   JWT_ACCESS_EXPIRES_IN=15m
#   JWT_REFRESH_EXPIRES_IN=7d
# Fase 6 (correo real, cuenta Resend del portafolio — SOLO remitente de prueba):
#   RESEND_API_KEY=
# Fase 7 (cobro, cuenta Stripe del portafolio — SOLO llaves sk_test_/pk_test_,
#         nunca sk_live_*, ver PLAN_DESARROLLO.md §0.2):
#   STRIPE_SECRET_KEY=
#   STRIPE_WEBHOOK_SECRET=
