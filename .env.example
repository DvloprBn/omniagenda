# Copia este archivo a ".env" y rellena los valores.
# ".env" NUNCA se sube a git (ya esta en .gitignore).
# Genera secretos con:  openssl rand -base64 24   /   openssl rand -hex 32

# --- PostgreSQL (omniagenda_db) ---
POSTGRES_USER=omniagenda_user
POSTGRES_PASSWORD=
POSTGRES_DB=omniagenda_db
# Host = "omniagenda_db" (servicio de docker-compose), NO localhost. Puerto
# interno 5432; el 5439 del host solo sirve para un cliente de escritorio.
DATABASE_URL=postgresql://omniagenda_user:PON_LA_MISMA_CONTRASENA_AQUI@omniagenda_db:5432/omniagenda_db

# --- Redis (omniagenda_redis) ---
REDIS_PASSWORD=

# --- Auth (Fase 3) ---
# JWT_SECRET: firma del access token. openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# TOTP_ENCRYPTION_KEY: cifra el secreto TOTP en reposo. EXACTAMENTE 32
# bytes en hex (64 caracteres). openssl rand -hex 32. NUNCA igual a JWT_SECRET.
TOTP_ENCRYPTION_KEY=

# --- Correo (Resend) — cuenta COMPARTIDA del portafolio, SOLO modo prueba ---
# Sin dominio verificado, usa el remitente onboarding@resend.dev (manda
# correos reales solo a la cuenta duena de la API key). PLAN §0.2.
RESEND_API_KEY=
# MAIL_FROM_ADDRESS=no-reply@tu-dominio-real.com

# --- Reservado para fases siguientes ---
# Fase 7 (cobro, Stripe del portafolio — SOLO sk_test_/pk_test_, nunca live):
#   STRIPE_SECRET_KEY=
#   STRIPE_WEBHOOK_SECRET=
